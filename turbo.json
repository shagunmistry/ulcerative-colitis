{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/CHANGELOG.md"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "test": {},
    "typecheck": {}
  }
}
